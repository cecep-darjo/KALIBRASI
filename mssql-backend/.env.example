# ============================================================
# Konfigurasi Backend KalibrasiMS (Express + SQL Server)
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ============================================================

# --- Pilih SALAH SATU mode koneksi di bawah ini ---

# Mode A — SQL Server Authentication (paling sederhana)
#   mssql://user:password@host:port/database
# MSSQL_CONNECTION_STRING=mssql://sa:rahasia@10.14.1.81:1433/DbKalibrasi

# Mode B — SQL Server Authentication dengan komponen terpisah
MSSQL_SERVER=10.14.1.81
MSSQL_PORT=1433
MSSQL_DATABASE=DbKalibrasi
MSSQL_USER=sa
MSSQL_PASSWORD=ubah_password_anda

# Nama instance, bila memakai named instance (mis. SQLEXPRESS / SQLTESTO).
# Bila diisi, biasanya port tidak perlu ditentukan.
# MSSQL_INSTANCE=SQLTESTO

# Mode C — Windows Authentication
#   Set true, lalu install driver tambahan: npm install msnodesqlv8
#   (MSSQL_USER dan MSSQL_PASSWORD diabaikan pada mode ini)
MSSQL_TRUSTED=false

# --- Aplikasi ---
PORT=4000
JWT_SECRET=ubah-menjadi-kunci-acak-yang-panjang-dan-rahasia
JWT_EXPIRES=8h

# Origin yang diizinkan mengakses API. Pisahkan dengan koma.
# Gunakan * untuk mengizinkan semua (hanya untuk pengembangan).
CORS_ORIGIN=*

# Basis URL verifikasi QR pada laporan PDF (opsional).
# Bila diisi, QR akan mengarah ke <base>/verify/<taskId>.
# REPORT_VERIFY_BASE_URL=https://kalibrasi.perusahaan.com
